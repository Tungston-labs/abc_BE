 @baseUrl = http://localhost:8000/api/ticket/


###############################################
# 1. PUBLIC WEBSITE – CREATE TICKET (NO AUTH)
###############################################

POST {{baseUrl}}public/
Content-Type: application/json

{
  "category": "connection",
  "notes": "Internet disconnecting frequently.",
  "name": "Arun Kumar",
  "phone": "9876543210",
  "address": "Aluva, Kochi"
}



###############################################
# 2. LCO APP – CREATE TICKET (AUTH REQUIRED)
###############################################

POST {{baseUrl}}lco/
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzY0ODU2MzM3LCJpYXQiOjE3NjQ4MzQ3MzcsImp0aSI6ImY3YjM1ZGU1YTk3MjQ1MmJiNjM2ODA4OTFlOTA4Yjk4IiwidXNlcl9pZCI6Mn0.5aF_d9Tk_RGsTVTNIPSJfTsT1ArDECGq4WluYx_qt1Y

{
  "category": "topup",
  "notes": "Customer requires urgent top-up",
  "customer_id": 45
}

