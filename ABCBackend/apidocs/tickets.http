 @baseUrl = http://localhost:8000/api/ticket/


###############################################
# 1. PUBLIC WEBSITE – CREATE TICKET (NO AUTH)
###############################################

POST {{baseUrl}}public/
Content-Type: application/json

{
  "category": "connection",
  "notes": "Internet disconnecting frequently.",
  "name": "Arun Kumar",
  "phone": "9876543210",
  "address": "Aluva, Kochi"
}



